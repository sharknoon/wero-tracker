# The wero API URL to fetch brand data from
DATA_WERO_P2P_API_URL=https://start.weropay.eu/api/brands
DATA_WERO_ECOM_API_URL=https://pay.weropay.eu/api/brands
# GitHub repository details to link assets to
GITHUB_ORG=sharknoon
GITHUB_REPO=wero-tracker
GITHUB_REF=refs/heads/main
ASSET_PATH=packages/data/assets
# Needed to fetch available websites for a bank
# Get your API key and CSE ID from https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CSE_ID=