{
  "name": "werotracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "npx @better-auth/cli generate --output db/schema/auth.ts",
    "shadcn:update": "npx shadcn@latest init --base radix --preset nova --reinstall"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1020.0",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^8.0.4",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "flag-icons": "^7.5.0",
    "json-stable-stringify": "^1.3.0",
    "lucide-react": "^1.7.0",
    "mime-types": "^3.0.2",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2"
  }
}
